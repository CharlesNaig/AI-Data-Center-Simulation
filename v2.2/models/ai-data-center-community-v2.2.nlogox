<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[extensions [bitmap]

breed [households household]
breed [data-centers data-center]
turtles-own [slot-index]
patches-own [land-kind baseline-green vegetation occupied?]

globals [
  ready? applied-settings
  it-mw it-utilization power-overhead water-intensity home-water home-power
  reservoir-limit recharge-rate grid-limit run-months allocation-policy
  recycled-water? solar? reforestation?
  reservoir-ml dc-request-ml household-request-ml site-water-ml it-energy-kwh
  grid-demand-percent green-coverage-percent wellbeing-score
  last-dc-request last-household-request dc-supplied-ml household-supplied-ml
  last-recharge-ml spilled-ml shortfall-ml balance-error-ml
  baseline-vegetation house-slots facility-slots tree-sites
  house-icons tree-icons sapling-icon number-glyphs
  house-icon server-icon tree-icon deer-icon reuse-icon solar-icon solar-legend-icon
  experiment-case
]

;; One tick = 30 days. Every numeric default is an illustrative teaching choice.
to setup
  validate-inputs
  without-interruption [
    clear-all
    set applied-settings selected-settings
    set it-mw facility-capacity-mw
    set it-utilization utilization-percent / 100
    set power-overhead pue
    set water-intensity wue-l-per-kwh
    set home-water household-liters-day
    set home-power household-kw
    set reservoir-limit reservoir-capacity-ml
    set recharge-rate recharge-ml-month
    set grid-limit grid-capacity-mw
    set run-months duration-months
    set allocation-policy water-allocation-policy
    set recycled-water? false
    set solar? false
    set reforestation? false
    initialize-land
    ;; Reproducible presentation layout; resource calculations consume no layout randomness.
    with-local-randomness [
      random-seed 2612
      set house-slots []
      let candidates shuffle sort patches with [pxcor >= 3 and pxcor <= 32 and pycor >= 10 and pycor <= 46]
      foreach candidates [candidate ->
        let cx [pxcor] of candidate
        let cy [pycor] of candidate
        if length house-slots < 50 and
          empty? (filter [xy -> abs (cx - item 0 xy) < 3 and abs (cy - item 1 xy) < 3] house-slots) [
          set house-slots lput (list cx cy) house-slots
        ]
      ]
      if length house-slots != 50 [error "Could not place all 50 non-overlapping household slots."]
      set tree-sites []
      repeat 900 [
        let grove one-of [[12 38] [24 22] [64 40] [80 31] [83 14] [64 17]]
        let tx random-normal (item 0 grove) 7
        let ty random-normal (item 1 grove) 5
        if tx > 3 and tx < 91 and ty > 12 and ty < 47 and
          empty? (filter [site -> sqrt ((tx - item 0 site) ^ 2 + (ty - item 1 site) ^ 2) < 3.5] tree-sites) [
          set tree-sites lput (list tx ty random 3) tree-sites
        ]
      ]
    ]
    let facility-candidates n-values 50 [i -> (list (59 + 5 * (i mod 7)) (46 - 5 * floor (i / 7)))]
    let compound [[69 31] [74 31] [79 31] [69 36] [74 36] [79 36] [64 31] [84 31] [64 36] [84 36]]
    set facility-slots sentence compound filter [xy -> not member? xy compound] facility-candidates
    foreach (sublist house-slots 0 starting-households) [location ->
      let hx item 0 location
      let hy item 1 location
      let footprint patches with [abs (pxcor - hx) <= 1 and abs (pycor - hy) <= 1]
      if count footprint != 9 or any? footprint with [land-kind != "land" or occupied?] [error "House slot overlaps protected or occupied ground."]
      create-households 1 [
        set slot-index count households - 1
        setxy item 0 location item 1 location
        hide-turtle
        ask patches with [abs (pxcor - round [xcor] of myself) <= 1 and abs (pycor - round [ycor] of myself) <= 1] [
          set land-kind "home"
          set occupied? true
        ]
      ]
    ]
    ask patches [
      set baseline-green ifelse-value (land-kind = "land") [1] [0]
      set vegetation baseline-green
    ]
    set baseline-vegetation sum [baseline-green] of patches
    repeat starting-data-centers [place-facility]
    set reservoir-ml reservoir-limit
    load-artwork
    set ready? true
    calculate-requests
    calculate-indicators
    reset-ticks
    render-scene
  ]
end

to startup
  setup
end

to initialize-land
  ask patches [
    set occupied? false
    set land-kind "frame"
    if pxcor >= 1 and pxcor <= 93 and pycor >= 5 and pycor <= 51 [set land-kind "land"]
    if land-kind = "land" and abs (pxcor - river-center pycor) <= 3 [set land-kind "river"]
    if land-kind = "land" and (member? pxcor [35 55] or pycor = 7 or
      (pycor = 26 and pxcor >= 35 and pxcor <= 55) or
      (pxcor >= 52 and pxcor <= 55 and pycor >= 10 and pycor <= 13)) [set land-kind "road"]
    if pxcor >= 95 [set land-kind "sidebar"]
  ]
end

to-report river-center [y]
  report 43 + 5 * sin ((y - 5) * 7)
end

to place-facility
  let next-slot count data-centers
  if next-slot >= length facility-slots [stop]
  let location item next-slot facility-slots
  let cx item 0 location
  let cy item 1 location
  let footprint patches with [abs (pxcor - cx) <= 1 and abs (pycor - cy) <= 1]
  if count footprint != 9 or any? footprint with [land-kind != "land" or occupied?] [
    error "Facility slot overlaps protected or occupied land."
  ]
  let clearing patches with [abs (pxcor - cx) <= 2 and abs (pycor - cy) <= 2]
  if count clearing != 25 or any? clearing with [land-kind != "land"] [error "Construction clearing overlaps protected terrain."]
  ask clearing [set vegetation 0]
  ask footprint [set occupied? true]
  create-data-centers 1 [
    set slot-index next-slot
    setxy cx cy
    hide-turtle
  ]
end

to build-more
  if not ready? [stop]
  without-interruption [
    if complete? or count data-centers >= 50 [stop]
    place-facility
    calculate-requests
    calculate-indicators
    render-scene
  ]
end

to go
  if not ready? or complete? [stop]
  ;; Buttons share one observer; keep each month and between-month action atomic.
  without-interruption [
    calculate-requests
    let previous-stock reservoir-ml
    set last-household-request household-request-ml
    set last-dc-request dc-request-ml
    set last-recharge-ml recharge-rate
    set spilled-ml max (list 0 (reservoir-ml + last-recharge-ml - reservoir-limit))
    set reservoir-ml min (list reservoir-limit (reservoir-ml + last-recharge-ml))
    let allocation allocate-requests reservoir-ml household-request-ml dc-request-ml allocation-policy
    set household-supplied-ml item 0 allocation
    set dc-supplied-ml item 1 allocation
    set shortfall-ml max (list 0 (household-request-ml + dc-request-ml - sum allocation))
    set reservoir-ml max (list 0 (reservoir-ml - sum allocation))
    set balance-error-ml previous-stock + last-recharge-ml - spilled-ml - sum allocation - reservoir-ml
    if reforestation? [
      ask patches with [baseline-green > 0 and not occupied? and vegetation < baseline-green] [
        set vegetation min (list baseline-green (vegetation + baseline-green / 12))
        if baseline-green - vegetation < 0.000000001 [set vegetation baseline-green]
      ]
    ]
    calculate-indicators
    check-invariants
    tick
    render-scene
  ]
end

;; Same allocation equations as V1; no water is created by a priority policy.
to-report allocate-requests [available home-request dc-request policy]
  let total-request home-request + dc-request
  if total-request = 0 [report (list 0 0)]
  if total-request <= available [report (list home-request dc-request)]
  if policy = "community-first" [
    let home-supply min (list home-request available)
    report (list home-supply (min (list dc-request (available - home-supply))))
  ]
  if policy = "data-center-first" [
    let dc-supply min (list dc-request available)
    report (list (min (list home-request (available - dc-supply))) dc-supply)
  ]
  let supply-ratio available / total-request
  report (list (home-request * supply-ratio) (dc-request * supply-ratio))
end

to check-invariants
  if abs balance-error-ml > 0.00000001 [error "Water balance failed."]
  if reservoir-ml < 0 or reservoir-ml > reservoir-limit + 0.00000001 [error "Reservoir out of bounds."]
  if household-supplied-ml < 0 or household-supplied-ml > last-household-request + 0.00000001 or
    dc-supplied-ml < 0 or dc-supplied-ml > last-dc-request + 0.00000001 [error "Allocation out of bounds."]
  if any? patches with [vegetation < 0 or vegetation > baseline-green + 0.00000001 or (occupied? and vegetation > 0)] [
    error "Vegetation violated the land constraints."
  ]
  if count data-centers > 50 or count households > 50 or count turtles != count data-centers + count households [
    error "Unexpected simulation agents."
  ]
end

to-report service-percent [supplied requested]
  report ifelse-value (requested = 0) [100] [100 * supplied / requested]
end

to calculate-requests
  set it-energy-kwh monthly-it-energy-kwh-for (count data-centers * it-mw * it-utilization)
  set site-water-ml monthly-site-water-ml-for it-energy-kwh water-intensity
  set dc-request-ml monthly-freshwater-ml-for site-water-ml (ifelse-value recycled-water? [50] [0])
  set household-request-ml count households * home-water * 30 / 1000000
  set grid-demand-percent 100 *
    (count data-centers * it-mw * it-utilization * power-overhead * (ifelse-value solar? [0.6] [1]) +
      count households * home-power / 1000) / grid-limit
end

to calculate-indicators
  set green-coverage-percent 100 * sum [vegetation] of patches / baseline-vegetation
  set wellbeing-score 0.40 * water-supply-percent + 0.30 * grid-headroom-percent + 0.30 * green-coverage-percent
end

to-report water-supply-percent
  report 100 * reservoir-ml / reservoir-limit
end

to-report grid-headroom-percent
  report max (list 0 (100 - grid-demand-percent))
end

to-report condition-for [score]
  if score >= 75 [report "Healthy"]
  if score >= 50 [report "Moderate"]
  if score >= 25 [report "Stressed"]
  report "Critical"
end

to-report complete?
  if not ready? [report false]
  report ticks >= run-months
end

to-report selected-settings
  report (list starting-data-centers starting-households facility-capacity-mw utilization-percent pue
    wue-l-per-kwh household-liters-day household-kw reservoir-capacity-ml recharge-ml-month
    grid-capacity-mw duration-months water-allocation-policy)
end

to validate-inputs
  foreach (list starting-data-centers starting-households) [n ->
    if n != floor n or n < 1 or n > 50 [error "Starting counts must be whole numbers from 1 to 50."]
  ]
  if facility-capacity-mw < 0 or utilization-percent < 0 or utilization-percent > 100 or pue < 1 or
    wue-l-per-kwh < 0 or household-liters-day < 0 or household-kw < 0 or reservoir-capacity-ml <= 0 or
    recharge-ml-month < 0 or grid-capacity-mw <= 0 or duration-months < 1 or duration-months != floor duration-months [
    error "Invalid assumptions: use nonnegative requests, positive capacities, PUE >= 1 and whole months."
  ]
  if not member? water-allocation-policy ["proportional" "community-first" "data-center-first"] [error "Unknown water allocation policy."]
end

to-report monthly-it-energy-kwh-for [load-mw]
  report load-mw * 1000 * 720
end

to-report monthly-site-water-ml-for [energy wue-value]
  ;; WUE uses IT energy, not PUE-adjusted facility electricity.
  report energy * wue-value / 1000000
end

to-report monthly-freshwater-ml-for [site-water reuse-percent]
  report site-water * (1 - reuse-percent / 100)
end

to show-statistics
  if not ready? [stop]
  ;; Native dialogs already pause forever buttons; Cancel may halt this procedure.
  user-message statistics-text
end

to-report statistics-text
  let last-month ifelse-value (ticks = 0) ["No monthly withdrawal yet. Advance one month.\n"] [
    (word "LAST COMPLETED MONTH (historical, before any later builds/solutions)\n"
      "Households: " precision household-supplied-ml 3 " / " precision last-household-request 3 " ML supplied ("
      precision (service-percent household-supplied-ml last-household-request) 2 "%)\n"
      "Facilities: " precision dc-supplied-ml 3 " / " precision last-dc-request 3 " ML supplied ("
      precision (service-percent dc-supplied-ml last-dc-request) 2 "%)\n"
      "Shortfall: " precision shortfall-ml 3 " ML; recharge: " precision last-recharge-ml 3
      " ML; spill: " precision spilled-ml 3 " ML\n")
  ]
  report (word "Month " ticks " / " run-months " (" precision (ticks / 12) 2 " years)"
    (ifelse-value complete? [" — COMPLETE; Setup to restart"] [""]) "\n"
    count households " households; " count data-centers " data centers\n\n"
    "Water stock: " precision reservoir-ml 3 " / " reservoir-limit " ML (" precision water-supply-percent 2 "%)\n"
    "Current monthly requests: homes " precision household-request-ml 3 "; facilities " precision dc-request-ml 3 " ML\n"
    "Grid demand: " precision grid-demand-percent 2 "% (100% = modeled capacity)\n"
    "Green coverage: " precision green-coverage-percent 2 "% of baseline\n"
    "Illustrative well-being: " precision wellbeing-score 2 " / 100 — " condition-for wellbeing-score "\n\n"
    last-month "\nAllocation: " allocation-policy "\n"
    "Solutions: recycled water " on-off recycled-water? ", solar " on-off solar? ", reforestation " on-off reforestation? "\n\n"
    "Score = 0.40 × water stock % + 0.30 × max(0, 100 − grid demand %) + 0.30 × green %\n"
    "Teaching weights and thresholds, not measured human health.\nML = million liters. 1 month = 30 days.")
end

to choose-solution
  if not ready? or complete? [stop]
  let choice user-one-of "Enable one solution; repeat choices never stack. Cancel changes nothing."
    ["Recycled water (50%)" "Solar energy (40%)" "Reforestation (12 months)"]
  if choice != false [enable-solution choice]
end

to enable-solution [choice]
  if not ready? or complete? [stop]
  without-interruption [
    if not member? choice ["Recycled water (50%)" "Solar energy (40%)" "Reforestation (12 months)"] [error "Unknown solution."]
    if choice = "Recycled water (50%)" [set recycled-water? true]
    if choice = "Solar energy (40%)" [set solar? true]
    if choice = "Reforestation (12 months)" [set reforestation? true]
    calculate-requests
    calculate-indicators
    render-scene
  ]
end

to load-artwork
  let house-size ifelse-value (count households <= 20) [32] [24]
  let server-size ifelse-value (count data-centers <= 10) [48] [ifelse-value (count data-centers <= 20) [40] [32]]
  set house-icon bitmap:scaled (bitmap:import "../assets/house.png") house-size house-size
  set server-icon bitmap:scaled (bitmap:import "../assets/facility.png") server-size server-size
  set tree-icon bitmap:scaled (bitmap:import "../assets/tree.png") 28 28
  set sapling-icon bitmap:scaled (bitmap:import "../assets/sapling.png") 20 20
  set deer-icon bitmap:scaled (bitmap:import "../assets/deer.png") 20 20
  set reuse-icon bitmap:scaled (bitmap:import "../assets/recycling.png") 24 24
  set solar-icon bitmap:scaled (bitmap:import "../assets/solar.png") 44 44
  set solar-legend-icon bitmap:scaled (bitmap:import "../assets/solar.png") 24 24
  set house-icons map [pixels -> bitmap:scaled house-icon pixels pixels] (list (house-size - 4) (house-size - 2) house-size)
  set tree-icons map [pixels -> bitmap:scaled tree-icon pixels pixels] [24 26 28]
  set number-glyphs map [family ->
    map [i -> bitmap:import (word "../assets/numbers/" family "-" i ".png")] (n-values 14 [i -> i])
  ] ["water" "grid" "green" "wellbeing"]
end

to draw-art [art cx cy]
  bitmap:copy-to-drawing art ((cx + 0.5) * patch-size - bitmap:width art / 2)
    ((max-pycor - cy + 0.5) * patch-size - bitmap:height art / 2)
end

to caption [cx cy words ink]
  ask patch cx cy [set plabel words set plabel-color ink]
end

to render-scene
  if not ready? [stop]
  clear-drawing
  ask patches [
    set plabel ""
    set pcolor [236 239 241]
    if land-kind = "land" [
      let variation ((pxcor * 13 + pycor * 7) mod 5) - 2
      set pcolor (map [[bare lush] -> bare + vegetation * (lush - bare)] [210 186 138] (list (165 + variation) (207 + variation) (112 + variation)))
      if occupied? [set pcolor [212 216 211]]
    ]
    if land-kind = "home" [set pcolor [168 205 120]]
    if land-kind = "road" [set pcolor [205 209 195]]
    if land-kind = "river" [
      set pcolor [195 216 214]
      if abs (pxcor - river-center pycor) <= 3 * water-supply-percent / 100 and reservoir-ml > 0 [
        set pcolor [7 150 232]
        if (pxcor + pycor * 3) mod 11 = 0 [set pcolor [87 200 245]]
      ]
      if pycor = 26 [set pcolor [134 95 49]]
    ]
  ]
  ;; Sprite visibility depends only on existing patch vegetation, never added agents.
  foreach tree-sites [site ->
    let tx item 0 site
    let ty item 1 site
    let phase vegetation-art-stage [vegetation] of patch tx ty
    if phase != "none" [
      let art ifelse-value (phase = "sapling") [sapling-icon] [item (item 2 site) tree-icons]
      let crown-radius bitmap:width art / (2 * patch-size)
      let required-green ifelse-value (phase = "sapling") [0.10] [0.75]
      let nearby [patches in-radius (crown-radius * sqrt 2 + 1)] of patch tx ty
      if not any? nearby with [abs (pxcor - tx) <= crown-radius and abs (pycor - ty) <= crown-radius and
        (land-kind != "land" or occupied? or vegetation < required-green)] and
        not any? households with [abs (xcor - tx) < crown-radius + bitmap:width (item (slot-index mod 3) house-icons) / (2 * patch-size) and
          abs (ycor - ty) < crown-radius + bitmap:height (item (slot-index mod 3) house-icons) / (2 * patch-size)] and
        not any? data-centers with [abs (xcor - tx) < crown-radius + bitmap:width server-icon / (2 * patch-size) and
          abs (ycor - ty) < crown-radius + bitmap:height server-icon / (2 * patch-size)] [draw-art art tx ty]
    ]
  ]
  foreach [[22 42] [72 23]] [xy ->
    let tx item 0 xy
    let ty item 1 xy
    let nearby [patches in-radius 2] of patch tx ty
    if not any? nearby with [abs (pxcor - tx) <= 1 and abs (pycor - ty) <= 1 and
      (land-kind != "land" or occupied? or vegetation < 0.75)] [draw-art deer-icon tx ty]
  ]
  foreach sort households [h -> draw-art (item ([slot-index] of h mod 3) house-icons) [xcor] of h [ycor] of h]
  foreach sort data-centers [dc -> draw-art server-icon [xcor] of dc [ycor] of dc]
  if solar? [draw-art solar-icon 59 31]
  if recycled-water? [draw-art reuse-icon 59 37]
  let ink [23 33 43]
  caption 31 50 (word "VILLAGE · " count households " HOMES") ink
  caption 92 50 (word "FACILITIES · " count data-centers " / 50") ink
  caption 47 27 "" ink
  draw-indicator 0 39 "WATER" water-supply-percent [189 223 255] [7 93 168]
    (word precision reservoir-ml 2 " / " reservoir-limit " ML")
    (ifelse-value (ticks = 0) ["Ready — step one month"]
      [ifelse-value (shortfall-ml > 0.000001) ["! Water shortfall"] ["Last month: demand met"]])
  draw-indicator 1 27 "GRID" grid-demand-percent [255 240 178] [148 96 0]
    "100% = modeled capacity"
    (ifelse-value (grid-demand-percent > 100) ["! Exceeds capacity"] ["Within capacity"])
  draw-indicator 2 15 "GREEN COVER" green-coverage-percent [185 243 193] [18 99 42]
    "Share of baseline vegetation"
    (ifelse-value reforestation? ["Restoring"] ["Construction clears"])
  draw-indicator 3 3 "WELL-BEING" wellbeing-score [255 208 213] [165 35 50]
    (word condition-for wellbeing-score " · " precision wellbeing-score 1 " / 100") "Illustrative score"
  caption 65 4 (word "Month " ticks "/" run-months " | Year " precision (ticks / 12) 2 " | " count households " homes / " count data-centers " DCs") ink
  draw-art house-icon 3 1.5
  draw-art tree-icon 20 1.5
  draw-art sapling-icon 36 1.5
  draw-art solar-legend-icon 54 1.5
  caption 14 1 "House" ink
  caption 31 1 "Tree" ink
  caption 49 1 "Sapling" ink
  caption 65 1 "Solar" ink
end

to-report vegetation-art-stage [amount]
  if amount < 0.10 [report "none"]
  if amount < 0.75 [report "sapling"]
  report "mature"
end

to draw-indicator [family bottom title amount header ink meaning status]
  ask patches with [pxcor >= 94 and pxcor <= 123 and pycor >= bottom and pycor <= bottom + 10] [set pcolor white]
  ask patches with [pxcor >= 95 and pxcor <= 122 and pycor >= bottom + 9 and pycor <= bottom + 10] [set pcolor header]
  caption 109 (bottom + 9) title [23 33 43]
  draw-large-number (word precision amount 1 (ifelse-value (family = 3) ["/100"] ["%"])) family bottom
  ask patches with [pxcor >= 98 and pxcor <= 121 and pycor = bottom + 4] [set pcolor [225 228 230]]
  ask patches with [pxcor >= 98 and pxcor <= 121 and pycor = bottom + 4 and pxcor < 98 + 24 * min (list 100 amount) / 100] [set pcolor ink]
  let card-copy status
  if family = 0 [set card-copy (word precision reservoir-ml 1 " ML " (ifelse-value (ticks = 0) ["Ready"] [ifelse-value (shortfall-ml > 0.000001) ["Shortfall"] ["OK"]]))]
  if family = 1 [set card-copy (ifelse-value (grid-demand-percent > 100) ["Exceeds capacity"] ["Within grid"])]
  if family = 2 [set card-copy (ifelse-value reforestation? ["Restoring"] ["Cleared"])]
  if family = 3 [set card-copy condition-for wellbeing-score]
  caption 109 (bottom + 1) card-copy [23 33 43]
  if family = 0 and shortfall-ml > 0.000001 [
    ask patches with [pxcor >= 95 and pxcor <= 124 and pycor >= bottom - 1 and pycor <= bottom + 11 and
      (pxcor = 95 or pxcor = 124 or pycor = bottom - 1 or pycor = bottom + 11)] [set pcolor [148 96 0]]
  ]
end

to draw-large-number [value family bottom]
  let chars "0123456789.%/-"
  let glyphs item family number-glyphs
  let widths map [i -> bitmap:width (item (position (substring value i (i + 1)) chars) glyphs)] (n-values length value [i -> i])
  let start-x (109.5 * patch-size - sum widths / 2)
  let offset 0
  foreach (n-values length value [i -> i]) [i ->
    let index position (substring value i (i + 1)) chars
    if index != false [
      let art item index glyphs
      bitmap:copy-to-drawing art (start-x + offset) ((max-pycor - bottom - 8) * patch-size)
      set offset offset + bitmap:width art
    ]
  ]
end

to-report on-off [enabled?]
  report ifelse-value enabled? ["ON"] ["OFF"]
end

to teaching-defaults
  set starting-data-centers 1
  set starting-households 10
  set facility-capacity-mw 1
  set utilization-percent 70
  set pue 1.6
  set wue-l-per-kwh 1
  set household-liters-day 500
  set household-kw 2
  set reservoir-capacity-ml 40
  set recharge-ml-month 8
  set grid-capacity-mw 40
  set duration-months 72
  set water-allocation-policy "proportional"
end

to setup-experiment
  let chosen-case experiment-case
  teaching-defaults
  if member? chosen-case ["recycled-water" "solar" "reforestation" "combined"] [set starting-data-centers 20]
  if chosen-case = "maximum" [set starting-data-centers 50 set starting-households 50]
  setup
  set experiment-case chosen-case
end

to go-experiment
  if complete? [stop]
  if experiment-case = "expansion" and ticks = 12 [repeat 19 [build-more]]
  if ticks = 24 [
    if member? experiment-case ["recycled-water" "combined" "maximum"] [enable-solution "Recycled water (50%)"]
    if member? experiment-case ["solar" "combined" "maximum"] [enable-solution "Solar energy (40%)"]
    if member? experiment-case ["reforestation" "combined" "maximum"] [enable-solution "Reforestation (12 months)"]
  ]
  go
end]]></code>
  <widgets>
    <monitor x="5" y="567" width="300" height="60" precision="2" fontSize="14" display="Water supply · reservoir %">water-supply-percent</monitor>
    <monitor x="311" y="567" width="300" height="60" precision="2" fontSize="14" display="Grid demand · capacity %">grid-demand-percent</monitor>
    <monitor x="617" y="567" width="300" height="60" precision="2" fontSize="14" display="Green coverage · baseline %">green-coverage-percent</monitor>
    <monitor x="923" y="567" width="300" height="60" precision="1" fontSize="14" display="Illustrative well-being / 100">word precision wellbeing-score 1 (word " · " condition-for wellbeing-score)</monitor>
    <plot x="5" y="637" width="400" height="185" xMin="0" xMax="6" yMin="0" yMax="100" autoPlotX="true" autoPlotY="false" legend="false" xAxis="Elapsed years (12 months)" yAxis="Reservoir %" display="Water Supply">
      <setup /><update>plotxy (ticks / 12) water-supply-percent</update>
      <pen interval="1" mode="0" display="Water stock" color="-14785356" legend="true"><setup /><update /></pen>
    </plot>
