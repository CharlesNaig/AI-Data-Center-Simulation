  <experiments>
    <experiment name="smoke-test" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="120">
      <setup>run-self-tests
setup-scenario</setup>
      <go>go</go>
      <exitCondition>ticks &gt;= 120</exitCondition>
      <metrics>
        <metric>count data-centers</metric>
        <metric>compute-demand-mw</metric>
        <metric>unserved-compute-demand-mw</metric>
        <metric>reservoir-stock-ml</metric>
        <metric>community-service-percent</metric>
        <metric>data-center-water-service-percent</metric>
        <metric>cumulative-emissions-tonnes</metric>
        <metric>water-stress-ratio</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="scenario"><value value="&quot;Reference baseline&quot;"></value></enumeratedValueSet>
      </constants>
    </experiment>

    <experiment name="scenario-comparison" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="120">
      <setup>setup-scenario</setup>
      <go>go</go>
      <exitCondition>ticks &gt;= 120</exitCondition>
      <metrics>
        <metric>count data-centers</metric>
        <metric>compute-demand-mw</metric>
        <metric>unserved-compute-demand-mw</metric>
        <metric>reservoir-stock-ml</metric>
        <metric>community-service-percent</metric>
        <metric>data-center-water-service-percent</metric>
        <metric>data-center-freshwater-request-ml</metric>
        <metric>cumulative-emissions-tonnes</metric>
        <metric>water-stress-ratio</metric>
      </metrics>
      <constants></constants>
      <subExperiments>
        <subExperiment>
          <enumeratedValueSet variable="scenario">
            <value value="&quot;Reference baseline&quot;"></value>
            <value value="&quot;Rapid growth + drought&quot;"></value>
            <value value="&quot;Efficiency + reuse&quot;"></value>
          </enumeratedValueSet>
        </subExperiment>
      </subExperiments>
    </experiment>

    <experiment name="rainfall-uncertainty" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="120">
      <setup>setup-rainfall-experiment</setup>
      <go>go</go>
      <exitCondition>ticks &gt;= 120</exitCondition>
      <metrics>
        <metric>count data-centers</metric>
        <metric>compute-demand-mw</metric>
        <metric>unserved-compute-demand-mw</metric>
        <metric>reservoir-stock-ml</metric>
        <metric>community-service-percent</metric>
        <metric>data-center-water-service-percent</metric>
        <metric>data-center-freshwater-request-ml</metric>
        <metric>cumulative-emissions-tonnes</metric>
        <metric>water-stress-ratio</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="scenario"><value value="&quot;Rapid growth + drought&quot;"></value></enumeratedValueSet>
      </constants>
      <subExperiments>
        <subExperiment>
          <steppedValueSet variable="seed-value" first="1" step="1" last="30"></steppedValueSet>
        </subExperiment>
      </subExperiments>
    </experiment>

    <experiment name="allocation-policy-check" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="120">
      <setup>setup-allocation-experiment</setup>
      <go>go</go>
      <exitCondition>ticks &gt;= 120</exitCondition>
      <metrics>
        <metric>community-freshwater-supplied-ml + data-center-freshwater-supplied-ml</metric>
        <metric>community-service-percent</metric>
        <metric>data-center-water-service-percent</metric>
        <metric>water-shortage-ml</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="scenario"><value value="&quot;Rapid growth + drought&quot;"></value></enumeratedValueSet>
      </constants>
      <subExperiments>
        <subExperiment>
          <enumeratedValueSet variable="water-allocation-policy">
            <value value="&quot;proportional&quot;"></value>
            <value value="&quot;community-first&quot;"></value>
            <value value="&quot;data-center-first&quot;"></value>
          </enumeratedValueSet>
        </subExperiment>
      </subExperiments>
    </experiment>
  </experiments>
