      <setup>setup-experiment</setup>
      <go>go-experiment</go>
      <exitCondition>complete?</exitCondition>
      <metrics>
        <metric>ticks</metric>
        <metric>count data-centers</metric>
        <metric>count households</metric>
        <metric>reservoir-ml</metric>
        <metric>water-supply-percent</metric>
        <metric>dc-request-ml</metric>
        <metric>household-request-ml</metric>
        <metric>shortfall-ml</metric>
        <metric>grid-demand-percent</metric>
        <metric>green-coverage-percent</metric>
        <metric>wellbeing-score</metric>
        <metric>condition-for wellbeing-score</metric>
        <metric>balance-error-ml</metric>
      </metrics>
      <subExperiments>
        <subExperiment>
          <enumeratedValueSet variable="experiment-case">
            <value value="&quot;baseline&quot;"></value>
            <value value="&quot;expansion&quot;"></value>
            <value value="&quot;recycled-water&quot;"></value>
            <value value="&quot;solar&quot;"></value>
            <value value="&quot;reforestation&quot;"></value>
            <value value="&quot;combined&quot;"></value>
            <value value="&quot;maximum&quot;"></value>
          </enumeratedValueSet>
        </subExperiment>
      </subExperiments>
    </experiment>
  </experiments>
