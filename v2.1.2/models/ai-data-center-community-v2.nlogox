    <button x="7" y="379" height="38" disableUntilTicks="false" forever="false" kind="Observer" width="97" display="☀ Add Solar">enable-solution "Solar energy (40%)"</button>
    <button x="109" y="379" height="38" disableUntilTicks="false" forever="false" kind="Observer" width="100" display="🌳 Reforest">enable-solution "Reforestation (12 months)"</button>
